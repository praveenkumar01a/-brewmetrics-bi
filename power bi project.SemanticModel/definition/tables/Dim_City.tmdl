table Dim_City
	lineageTag: e3de1ce0-c516-4a41-85ff-5cb0cd009158

	measure 'Total Sales' =
			
			SUM(Fact_Sales[sales_amount])
		lineageTag: 8f3ab015-d502-4fdf-9ac9-2fb6411f6a49

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Sales Growth' =
			
			VAR CurrentSales =
			    [Total Sales]
			
			VAR PreviousSales =
			    CALCULATE(
			        [Total Sales],
			        DATEADD(Dim_Date[date], -1, MONTH)
			    )
			
			RETURN
			    DIVIDE(
			        CurrentSales - PreviousSales,
			        PreviousSales
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d47ecbaf-e839-437f-84e9-eea17a17e4b0

	measure 'Running Total Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        ALL(Dim_Date[date]),
			        Dim_Date[date] <= MAX(Dim_Date[date])
			    )
			)
		lineageTag: dff2f7fb-f61b-479f-8221-73b29b5fbd2c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Rank' =
			
			RANKX(
			    ALL(Dim_Product[item]),
			    [Total Sales],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: cde1c7a8-f1f7-4d34-b44a-ca0c79e5025c

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Sales],
			    DISTINCTCOUNT(Fact_Sales[date])
			)
		lineageTag: 8db13e92-dc76-492c-9606-faed2075d3b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column city
		dataType: string
		lineageTag: 8ad2eb81-3882-437f-9db1-85f2188140c1
		summarizeBy: none
		sourceColumn: city

		annotation SummarizationSetBy = Automatic

	partition Dim_City = m
		mode: import
		source =
				let
				    Source = Fact_Sales,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"city"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns")
				in
				    #"Removed Duplicates"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

